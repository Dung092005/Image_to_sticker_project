# Supabase Postgres (same DB as Sticker-WEBAPP). Percent-encode special chars in password.
DATABASE_URL=postgresql://postgres.<project-ref>:<encoded-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Frontend origin(s), comma-separated. Local + Vercel.
APP_ORIGIN=http://localhost:5173
# COOKIE_SECURE=true
# COOKIE_SAMESITE=Lax

# Google OAuth. Add the exact callback URL to the OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Paste full service-account JSON as one line on Render (optional locally if using gcloud ADC).
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

GCP_PROJECT_ID=your-google-cloud-project
GCP_LOCATION=us-central1
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Or point Google GenAI at a local service-account file. Leave unset when using gcloud ADC.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Optional on Windows if `python` is not on PATH:
# STICKAI_PYTHON=C:\Users\admin\AppData\Local\Programs\Python\Python312\python.exe
# On macOS/Linux, set the absolute path if the default python3 is not usable:
# STICKAI_PYTHON=/usr/bin/python3
# Optional: promote Google emails to admin
# ADMIN_EMAILS=you@gmail.com

# Optional database tuning.
# DATABASE_POOL_MAX=5
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
